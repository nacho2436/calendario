#!/bin/bash
# Antes de desinstalar: detiene el servicio del usuario que instaló
# y deshabilita el arranque automático. Los datos NO se tocan.
USU="${SUDO_USER:-${USER:-}}"
if [ -n "$USU" ] && [ "$USU" != "root" ]; then
    UU="$(id -u "$USU" 2>/dev/null || true)"
    if [ -n "$UU" ] && [ -d "/run/user/$UU" ]; then
        sudo -u "$USU" XDG_RUNTIME_DIR="/run/user/$UU" \
            systemctl --user stop micalendario.service >/dev/null 2>&1 || true
    fi
fi
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    systemctl --global disable micalendario.service >/dev/null 2>&1 || true
fi
exit 0
