[Unit]
Description=Mi Calendario - servidor web local
Documentation=https://github.com/nacho2436/calendario
After=network.target

[Service]
Type=simple
Environment=MCALENDARIO_DATOS=%h/.local/share/micalendario
ExecStart=/usr/bin/python3 /opt/micalendario/servidor.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
